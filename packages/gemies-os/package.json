{
  "name": "@gemies/os",
  "version": "0.1.0",
  "description": "GemiesOS: the gemies' computers — one gVisor-sandboxed container per actor and a shared, proxied browser, behind a control API only the Gemies API can call",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/index.js",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gemies/os-protocol": "workspace:*",
    "express": "^4.22.2",
    "pino": "^10.3.1",
    "playwright-core": "1.64.0",
    "postgres": "3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxy.so/core": "7.51.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
